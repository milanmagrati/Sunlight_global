# Block all direct web access to this folder.
# Matters if the app ever ends up inside public_html (deployment "Option B") --
# without this, the sqlite database file could be downloaded straight from a URL.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
